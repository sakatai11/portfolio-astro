---
import '@/styles/global.css'

import { ClientRouter } from 'astro:transitions'

type Props = {
  title: string
  fullBleed?: boolean
  /** 文書の主言語。本文は英語で統一しているため既定は `en` */
  lang?: 'en' | 'ja'
}

const { title, fullBleed = false, lang = 'en' } = Astro.props
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Photography Portfolio" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ClientRouter />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <!-- pl-* はサイドバナー (Header.astro) の幅と対応させ、コンテンツが下に潜らないようにする。
       トップページ (fullBleed) はバナーをコンテンツに重ねるため付与しない。 -->
  <body class:list={[!fullBleed && 'pl-banner md:pl-banner-md']}>
    <slot />
  </body>
</html>
