---
import '@/styles/global.css'

import { ClientRouter } from 'astro:transitions'

import Seo from '@/components/common/Seo.astro'
import GoogleTagManager from '@/components/common/GoogleTagManager.astro'
import GoogleTagManagerNoscript from '@/components/common/GoogleTagManagerNoscript.astro'

type Props = {
  title: string
  /** meta description / og:description。省略時はサイト共通の説明文 */
  description?: string
  /** OGP 画像。public 配下の相対パスと絶対 URL の両方を受け付ける */
  ogImage?: string
  ogType?: 'website' | 'article'
  /** 検索エンジンにインデックスさせないページで true にする */
  noindex?: boolean
  fullBleed?: boolean
  /** 文書の主言語。本文は英語で統一しているため既定は `en` */
  lang?: 'en' | 'ja'
  /**
   * 写真画像 (images.microcms-assets.io / サイト本体とは別オリジン) を表示する
   * ページで true にする。画像を持たない `/`・`/about`・`/404` で preconnect すると、
   * 使われない接続の確立コストだけが乗るため既定は無効。
   * img に crossorigin 属性は付けていないため、preconnect も crossorigin なしで揃える。
   */
  preconnectMicrocms?: boolean
}

const {
  title,
  description,
  ogImage,
  ogType,
  noindex,
  fullBleed = false,
  lang = 'en',
  preconnectMicrocms = false,
} = Astro.props
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />

    {
      preconnectMicrocms && (
        <link rel="preconnect" href="https://images.microcms-assets.io" />
      )
    }

    <Seo
      title={title}
      description={description}
      ogImage={ogImage}
      ogType={ogType}
      noindex={noindex}
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- iOS の「ホーム画面に追加」は SVG を扱えないため PNG を併置する -->
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#ffffff" />

    <GoogleTagManager />

    <ClientRouter />
  </head>
  <!-- pl-* はサイドバナー (Header.astro) の幅と対応させ、コンテンツが下に潜らないようにする。
       トップページ (fullBleed) はバナーをコンテンツに重ねるため付与しない。 -->
  <body class:list={[!fullBleed && 'pl-banner md:pl-banner-md']}>
    <GoogleTagManagerNoscript />
    <slot />
  </body>
</html>
