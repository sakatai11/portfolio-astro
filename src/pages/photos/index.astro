---
import Layout from '@/layouts/Layout.astro'
import Header from '@/components/common/Header.astro'
import Footer from '@/components/common/Footer.astro'
import PageTitle from '@/components/common/PageTitle.astro'
import PhotoLoadMoreGrid from '@/components/photos/PhotoLoadMoreGrid.tsx'
import GridContainer from '@/components/common/GridContainer.astro'

import { getMicroCmsListResponse } from '@/services/microcms'
import { PHOTOS_PER_PAGE } from '@/constants/index'
import type { PhotosMain } from '@/types/index'

const { contents: photos, totalCount } =
  await getMicroCmsListResponse<PhotosMain>({
    endpoint: 'photos',
    queries: {
      fields: ['id', 'title', 'main', 'publishedAt'],
      limit: PHOTOS_PER_PAGE,
    },
  })

// `/api/photos/[page].json.ts` と同じ区切りで数える必要がある
const totalPages = Math.ceil(totalCount / PHOTOS_PER_PAGE)
---

<Layout title="Photos | Taichi Sakai">
  <Header />
  <main class="w-full py-12">
    <PageTitle title="PHOTOS" />
    <GridContainer>
      <PhotoLoadMoreGrid
        client:idle
        initialPhotos={photos}
        totalPages={totalPages}
      />
    </GridContainer>
  </main>
  <Footer />
</Layout>
