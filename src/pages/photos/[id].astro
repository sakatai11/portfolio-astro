---
import Layout from '@/layouts/Layout.astro'
import Detail from '@/components/photos/Detail.astro'
import {
  getMicroCmsList,
  getMicroCmsAllList,
  getMicroCmsDetail,
} from '@/services/microcms'
import type { PhotosMain, PhotoDetail } from '@/types/index'
import Header from '@/components/common/Header.astro'
import Footer from '@/components/common/Footer.astro'
import ContentsGallery from '@/components/photos/ContentsGallery.astro'

export async function getStaticPaths() {
  // 全コンテンツ分の詳細ページを生成する必要があるため全件取得する
  const photos = await getMicroCmsAllList<PhotosMain>({
    endpoint: 'photos',
    queries: { fields: ['id'] },
  })

  return photos.map((photo) => ({
    params: { id: photo.id },
  }))
}

const { id } = Astro.params

const photoDetail: PhotoDetail = await getMicroCmsDetail<PhotoDetail>({
  endpoint: 'photos',
  contentId: id!,
})

/**
 * 表示中の写真と同じカメラで撮影された他の写真を取得する。
 * camera はセレクトフィールド（配列）のため [contains] で絞り込み、表示中の写真自身は除外する。
 */
const camera = photoDetail.camera?.[0]

const relatedPhotos: PhotosMain[] = camera
  ? await getMicroCmsList<PhotosMain>({
      endpoint: 'photos',
      queries: {
        fields: ['id', 'title', 'main', 'publishedAt'],
        filters: `camera[contains]${camera}[and]id[not_equals]${id}`,
      },
    })
  : []
---

<Layout title={`${photoDetail.title} | Taichi Sakai`}>
  <Header />
  <main class="w-full">
    <Detail photoDetail={photoDetail} />
    {camera && <ContentsGallery photos={relatedPhotos} />}
  </main>
  <Footer />
</Layout>
