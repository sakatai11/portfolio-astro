---
import Layout from '@/layouts/Layout.astro'
import Header from '@/components/common/Header.astro'
import Container from '@/components/common/Container.astro'
import Footer from '@/components/common/Footer.astro'
---

<Layout
  title="About | Taichi Sakai"
  description="Taichi Sakai is a Tokyo-based hobbyist photographer drawn to the mountains and the quiet scenes of everyday life, shooting mainly on film."
>
  <Header />
  <Container>
    <h1 class="sans my-4 text-center font-sans text-4xl tracking-widest uppercase md:text-5xl">
      About
    </h1>

    <div class="mt-22 grid grid-cols-1 items-start gap-3 md:grid-cols-2 md:gap-20">
      <div class="profile-image top-32">
        <img
          src="https://picsum.photos/seed/profile/600/800"
          alt="Portrait of Taichi Sakai"
          class="w-full opacity-90 grayscale-[30%]"
        />
      </div>
      <div class="bio pt-8">
        <div class="space-y-8 font-light text-[var(--color-accent)]">
          <div>
            <p class="text-sm tracking-[0.15em] text-[var(--color-accent)] text-center md:text-left">
              Hobbyist Photographer / Tokyo, Japan
            </p>
            <h2 class="mt-2 sans font-sans text-2xl tracking-[0.1em] text-center text-[var(--color-text)] md:text-left md:text-3xl">
              Taichi Sakai
            </h2>
          </div>
          <p class="text-xl leading-relaxed text-[var(--color-text)]">
            I take photographs as a hobby, based in Tokyo — drawn mainly to
            the mountains and the quiet scenes of everyday life.
          </p>
          <p>
            Film is my camera of choice, valued for its texture and unhurried
            pace — though I occasionally reach for a mirrorless camera for
            sports or mountain trips.
          </p>
        </div>
        <div class="mt-16 border-t border-[var(--color-border)] pt-10">
          <h3 class="mb-6 sans font-sans text-lg tracking-[0.06em]">Follow</h3>
          <a
            href="https://www.instagram.com/ski_tt18/"
            rel="noopener noreferrer"
            target="_blank"
            class="inline-flex items-center gap-2 relative border-b border-transparent text-sm transition-colors after:absolute after:-bottom-1 after:left-0 after:h-[1px] after:w-full after:origin-left after:scale-x-0 after:bg-black after:transition-transform after:duration-300 after:ease-out hover:text-black hover:after:scale-x-100 md:text-sm"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="h-5 w-5"
            >
              <rect x="3" y="3" width="18" height="18" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
            Instagram
          </a>
        </div>
      </div>
    </div>
  </Container>
  <Footer />
</Layout>
