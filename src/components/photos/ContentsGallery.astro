---
import type { PhotosMain } from '@/types/index'

type Props = {
  photos: PhotosMain[]
}

const { photos } = Astro.props
---

{
  photos.length > 0 && (
    <section class="mx-auto max-w-[1600px] px-6 pb-16 md:px-[5.5rem] md:pb-20">
      <div class="border-t border-[var(--color-border)] pt-16 md:pt-18">
        <h2 class="text-center font-sans text-3xl tracking-widest uppercase">
          CONTENTS
        </h2>
      </div>

      <ul class="mt-12 grid grid-cols-1 gap-[7.8vw] px-20 md:mt-16 md:grid-cols-3">
        {photos.map(({ id, title, main }) => (
          <li>
            <div class="overflow-hidden">
              <a href={`/photos/${id}`} class="group block">
                <picture>
                  <source srcset={`${main.url}?fm=webp`} type="image/webp" />
                  <img
                    src={main.url}
                    alt={title}
                    width={main.width}
                    height={main.height}
                    class="aspect-[3/2] w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105 group-hover:opacity-80"
                    loading="lazy"
                    decoding="async"
                  />
                </picture>
              </a>
            </div>
          </li>
        ))}
      </ul>
    </section>
  )
}
