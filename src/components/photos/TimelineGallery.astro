---
import type { PhotosMain } from '@/types/index'
import { buildYearEvents } from '@/utils'

type Props = {
  photos: PhotosMain[]
}

const { photos } = Astro.props

const events = buildYearEvents(photos)
---

<section
  class="mx-auto max-w-[1600px] px-6 pb-16 md:px-[5.5rem] md:pb-20"
>
  <div class="border-t border-[var(--color-border)] pt-16 md:pt-18">
    <h2 class="text-center font-sans text-3xl tracking-widest uppercase">
      TIMELINE
    </h2>
  </div>

  <ul class="px-20 mt-12 flex flex-col gap-[10.4vw] md:mt-16 md:flex-row">
    {
      events.map((event) => (
        <li>
          <div class="overflow-hidden">
            <a href={`/timeline/${event.year}`} class="group block">
              <picture>
                <source
                  srcset={`${event.image}?fm=webp`}
                  type="image/webp"
                />
                <img
                  src={event.image}
                  alt=""
                  class="aspect-[3/2] w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105 group-hover:opacity-80"
                  loading="lazy"
                  decoding="async"
                />
              </picture>
            </a>
          </div>
          <div class="pt-2">
            <span
              class="pl-0.5 inline-block text-xs tracking-[0.2em] text-[var(--color-accent)] uppercase transition-colors md:text-sm"
            >
              {event.year}
            </span>
          </div>
        </li>
      ))
    }
  </ul>
</section>
