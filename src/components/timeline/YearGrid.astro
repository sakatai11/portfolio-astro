---
import type { YearEvent } from '@/types/index'

type Props = {
  events: YearEvent[]
}

const { events } = Astro.props
---

<ul class="grid grid-cols-1 gap-3 md:gap-[7.8vw] md:grid-cols-3">
  {
    events.map((event) => (
      <li>
        <a
          href={`/timeline/${event.year}`}
          class="group block cursor-pointer overflow-hidden"
        >
          <picture>
            <source srcset={`${event.image}?fm=webp`} type="image/webp" />
            <img
              src={event.image}
              alt={event.year}
              width={event.width}
              height={event.height}
              class="aspect-[3/2] w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105 group-hover:opacity-80"
              loading="lazy"
              decoding="async"
            />
          </picture>
          <span class="mt-2 block text-sm tracking-[0.2em] text-[var(--color-accent)] uppercase">
            {event.year}
          </span>
        </a>
      </li>
    ))
  }
</ul>
