---
const navLinks = [
  { href: '/photos', label: 'PHOTOS' },
  { href: '/about', label: 'About' },
  { href: '/timeline', label: 'TIMELINE' },
]

/**
 * ナビゲーションリンクのスタイル。
 * 縦書きレイアウトのため、ホバー時の下線は文字列の右側に縦線として引く。
 */
const navLinkClass = [
  'relative inline-block text-xs tracking-[0.2em] text-[var(--color-accent)] uppercase transition-colors md:text-sm',
  'hover:text-black hover:after:scale-y-100',
].join(' ')
---

<!--
  writing-mode: vertical-rl 配下では Tailwind の論理プロパティ (inset-y-*, py-* 等) が
  横方向に効いてしまうため、位置と余白は物理プロパティ (top/bottom/pt/pb) で指定する。
-->
<header
  id="header"
  class="w-banner md:w-banner-md fixed top-0 bottom-0 left-0 z-100 flex items-center justify-between pt-6 pb-6 [writing-mode:vertical-rl]"
>
  <a
    href="/"
    class="font-serif text-base font-medium tracking-[0.2em] whitespace-nowrap transition-colors hover:text-black"
    >TAICHI SAKAI</a
  >
  <nav class="flex gap-8">
    {
      navLinks.map(({ href, label }) => (
        <a href={href} class={navLinkClass}>
          {label}
        </a>
      ))
    }
  </nav>
</header>

<script>
  /**
   * ページロード時にヘッダーの初期化処理を実行する。
   * ViewTransitions によるSPA遷移後も astro:page-load で再実行される。
   */
  document.addEventListener('astro:page-load', () => {
    disableCurrentPageLinks()
  })

  /**
   * 現在のページと同じ href を持つナビゲーションリンクのクリックを無効化する。
   * mailto: リンクは対象外。
   */
  function disableCurrentPageLinks(): void {
    const currentPath = window.location.pathname
    document
      .querySelectorAll<HTMLAnchorElement>(
        'header a[href]:not([href^="mailto:"])'
      )
      .forEach((link) => {
        if (link.getAttribute('href') === currentPath) {
          link.addEventListener('click', (e) => e.preventDefault())
        }
      })
  }
</script>
