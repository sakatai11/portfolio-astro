---
type Props = {
  title: string
}

const { title } = Astro.props
---

<div class="mb-16 text-center">
  <h1
    class="sans my-4 text-center font-sans text-3xl tracking-widest uppercase"
  >
    {title}
  </h1>
  <a
    href="/"
    class="relative inline-block border-b border-transparent text-sm transition-colors after:absolute after:-bottom-1 after:left-0 after:h-[1px] after:w-full after:origin-left after:scale-x-0 after:bg-black after:transition-transform after:duration-300 after:ease-out hover:text-black hover:after:scale-x-100 md:text-sm"
    >Back to Home</a
  >
</div>
